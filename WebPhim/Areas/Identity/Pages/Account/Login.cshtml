@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-register.css" asp-append-version="true" />
}

<div class="auth-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                @* Nới rộng một chút để input thoáng hơn *@

                <div class="card auth-card shadow-lg">
                    @* HEADER: Giữ nguyên phong cách sang trọng của CinemaVP *@
                    <div class="card-header auth-header-dark">
                        <h3 class="fw-bold my-1 d-flex align-items-center justify-content-center">
                            <i class="fas fa-user-circle nav-auth-icon me-2"></i>ĐĂNG NHẬP
                        </h3>
                        <p class="mb-0 small opacity-75">Chào mừng bạn quay trở lại với CinemaVP!</p>
                    </div>

                    <div class="card-body auth-body">
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                            @* FIX CHÍNH: Cấu trúc Floating Label chuẩn để không bị đè chữ *@
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email" class="text-muted">Địa chỉ Email</label>
                                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.Password" class="text-muted">Mật khẩu</label>
                                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                            </div>

                            @* Ghi nhớ & Quên mật khẩu *@
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberMe" style="cursor:pointer" />
                                    <label class="form-check-label small text-muted" asp-for="Input.RememberMe" style="cursor:pointer">
                                        Ghi nhớ tôi
                                    </label>
                                </div>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none text-danger fw-bold hover-underline">Quên mật khẩu?</a>
                            </div>

                            @* Nút Xác nhận *@
                            <button id="login-submit" type="submit" class="btn-auth">
                                Xác nhận Đăng nhập
                            </button>

                            <hr class="my-4 opacity-25">

                            @* Link Đăng ký *@
                            <div class="text-center">
                                <p class="small text-muted mb-1">Bạn chưa có tài khoản?</p>
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-bold text-dark auth-link-hover">
                                    <i class="fas fa-user-plus me-1 small"></i>Đăng ký thành viên mới
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                @* Quay về trang chủ *@
                <div class="text-center mt-4">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none opacity-75 hover-opacity-100">
                        <i class="fas fa-arrow-left me-1"></i> Quay về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}