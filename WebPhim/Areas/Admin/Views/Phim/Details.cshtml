@model WebPhim.Models.Phim
@{
    ViewData["Title"] = "Quản lý phim: " + Model.TenPhim;
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center mb-4">
        <<a href="javascript:void(0);" onclick="history.back();" class="btn btn-outline-secondary btn-sm rounded-pill me-3">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h2 class="h3 mb-0 fw-bold text-dark">Chi tiết phim hệ thống</h2>
    </div>

    <div class="row">
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="position-relative">
                    <img src="@Model.HinhAnh" class="w-100 d-block" style="object-fit: cover; height: 500px;"
                         onerror="this.src='https://placehold.co/500x750?text=No+Poster'">
                    <div class="position-absolute top-0 end-0 m-3">
                        <span class="badge bg-danger shadow-sm px-3 py-2">@Model.LoaiPhim</span>
                    </div>
                </div>
                <div class="card-body bg-light text-center border-top">
                    <p class="text-muted small mb-1">Mã định danh phim (ID)</p>
                    <h5 class="fw-bold text-primary">#@Model.Id</h5>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h1 class="display-6 fw-bold text-dark mb-2">@Model.TenPhim</h1>
                            <div class="d-flex gap-3 text-muted">
                                <span><i class="far fa-clock me-1 text-primary"></i> @Model.ThoiLuong phút</span>
                                <span><i class="fas fa-user-tie me-1 text-primary"></i> Đạo diễn: @Model.DaoDien</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 shadow-sm">
                                <i class="fas fa-edit me-1"></i> Chỉnh sửa
                            </a>
                        </div>
                    </div>

                    <hr class="my-4" style="opacity: 0.1;">

                    <div class="mb-4">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-align-left me-2 text-primary"></i>Nội dung phim</h5>
                        <div class="p-3 rounded-3 bg-light border">
                            <p class="text-secondary mb-0" style="line-height: 1.6; text-align: justify;">
                                @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả cho phim này." : Model.MoTa)
                            </p>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-white">
                                <span class="text-muted small d-block mb-1">Trạng thái</span>
                                <span class="fw-bold text-success"><i class="fas fa-check-circle me-1"></i> Đang khả dụng</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 border rounded-3 bg-white">
                                <span class="text-muted small d-block mb-1">Khu vực hiển thị</span>
                                <span class="fw-bold text-info"><i class="fas fa-globe me-1"></i> Toàn hệ thống</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>