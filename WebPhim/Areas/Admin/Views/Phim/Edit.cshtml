@model WebPhim.Models.Phim

@{
    ViewData["Title"] = "Chỉnh Sửa Phim: " + Model.TenPhim;
}

@* Import file CSS riêng cho trang Edit *@
<link rel="stylesheet" href="~/css/EditPhim.css" />

<div class="container py-4">
    <div class="edit-movie-container">

        @* Header màu vàng đồng bộ với nút Edit *@
        <div class="edit-header shadow-sm">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-edit me-2"></i>CHỈNH SỬA THÔNG TIN PHIM
            </h5>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @* QUAN TRỌNG: Giữ lại Id và HinhAnh cũ *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="HinhAnh" />

            <div class="edit-row">
                @* --- CỘT TRÁI: NHẬP LIỆU --- *@
                <div class="edit-form-side">

                    <div class="form-group-custom">
                        <label asp-for="TenPhim"><i class="fas fa-heading me-1 text-warning"></i>Tên Phim</label>
                        <input asp-for="TenPhim" class="form-control-custom w-100 fw-bold fs-5" placeholder="Nhập tên phim..." />
                        <span asp-validation-for="TenPhim" class="text-danger small"></span>
                    </div>

                    <div class="form-group-custom">
                        <label asp-for="MoTa"><i class="fas fa-align-left me-1 text-warning"></i>Mô Tả Nội Dung</label>
                        <textarea asp-for="MoTa" class="form-control-custom w-100" rows="6">@Model.MoTa</textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label asp-for="LoaiPhim"><i class="fas fa-tags me-1 text-warning"></i>Thể Loại</label>
                                <input asp-for="LoaiPhim" class="form-control-custom w-100" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label asp-for="ThoiLuong"><i class="fas fa-clock me-1 text-warning"></i>Thời Lượng</label>
                                <div class="input-group">
                                    <input asp-for="ThoiLuong" class="form-control-custom border-end-0 flex-grow-1" type="number" />
                                    <span class="input-group-text bg-white border-start-0 text-muted" style="border-radius: 0 10px 10px 0; border: 1px solid #eee;">phút</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label asp-for="DaoDien"><i class="fas fa-user-tie me-1 text-warning"></i>Đạo Diễn</label>
                                <input asp-for="DaoDien" class="form-control-custom w-100" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group-custom">
                                <label asp-for="KhuVuc"><i class="fas fa-layer-group me-1 text-warning"></i>Khu Vực</label>
                                <select asp-for="KhuVuc" class="form-control-custom w-100 shadow-none">
                                    <option value="Phim Đang Chiếu">Phim Đang Chiếu</option>
                                    <option value="Phim Sắp Chiếu">Phim Sắp Chiếu</option>
                                    <option value="Phim Hot">Phim Hot Trending</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group-custom mt-3">
                        <label asp-for="FileAnh"><i class="fas fa-image me-1 text-warning"></i>Thay Đổi Poster</label>
                        <input asp-for="FileAnh" type="file" class="form-control-custom w-100" id="imgInput" accept="image/*" />
                        <div class="form-text mt-2 text-muted italic">Để trống nếu Hiếu muốn giữ nguyên ảnh hiện tại.</div>
                    </div>

                    @* Khối nút bấm *@
                    <div class="mt-5 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn-save-edit">
                            <i class="fas fa-save me-2"></i>CẬP NHẬT NGAY
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill d-flex align-items-center">
                            <i class="fas fa-undo me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </div>

                @* --- CỘT PHẢI: POSTER --- *@
                <div class="edit-poster-side text-center">
                    <p class="poster-label">POSTER HIỆN TẠI / MỚI</p>
                    <div class="poster-edit-wrapper mx-auto">
                        <img id="imgPreview"
                             src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "https://placehold.co/400x600?text=No+Poster" : Model.HinhAnh)"
                             class="poster-edit-img" alt="Preview" />
                    </div>
                    <p class="small text-muted mt-3 italic"><i class="fas fa-info-circle me-1"></i>Tỉ lệ chuẩn 2:3</p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imgInput').onchange = function (evt) {
            const [file] = this.files;
            if (file) {
                const preview = document.getElementById('imgPreview');
                preview.src = URL.createObjectURL(file);
                preview.onload = () => URL.revokeObjectURL(preview.src);
            }
        };
    </script>
}