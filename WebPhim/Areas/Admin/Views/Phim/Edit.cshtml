@model WebPhim.Models.Phim

@{
    ViewData["Title"] = "Chỉnh Sửa Phim: " + Model.TenPhim;
}

@* Sử dụng lại class admin-card-container để đẩy Footer xuống đáy *@
<div class="container py-4 admin-card-container">
    <div class="card shadow-sm border-0 overflow-hidden">

        @* Header màu Warning để phân biệt với trang Thêm mới (Primary) *@
        <div class="card-header bg-warning text-dark py-3">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-edit me-2"></i>CHỈNH SỬA THÔNG TIN PHIM
            </h5>
        </div>

        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @* QUAN TRỌNG: Giữ lại Id và HinhAnh cũ *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="HinhAnh" />

                <div class="row g-4">
                    @* --- CỘT TRÁI: NHẬP LIỆU --- *@
                    <div class="col-lg-8">
                        <div class="mb-3">
                            <label asp-for="TenPhim" class="form-label fw-bold"><i class="fas fa-heading me-1 text-warning"></i>Tên Phim</label>
                            <input asp-for="TenPhim" class="form-control form-control-lg border-2" placeholder="Nhập tên phim..." />
                            <span asp-validation-for="TenPhim" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold"><i class="fas fa-align-left me-1 text-warning"></i>Mô Tả Nội Dung</label>
                            <textarea asp-for="MoTa" class="form-control border-2" rows="5">@Model.MoTa</textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="LoaiPhim" class="form-label fw-bold"><i class="fas fa-tags me-1 text-warning"></i>Thể Loại</label>
                                <input asp-for="LoaiPhim" class="form-control border-2" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ThoiLuong" class="form-label fw-bold"><i class="fas fa-clock me-1 text-warning"></i>Thời Lượng</label>
                                <div class="input-group">
                                    <input asp-for="ThoiLuong" class="form-control border-2" type="number" />
                                    <span class="input-group-text border-2 bg-light">phút</span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DaoDien" class="form-label fw-bold"><i class="fas fa-user-tie me-1 text-warning"></i>Đạo Diễn</label>
                                <input asp-for="DaoDien" class="form-control border-2" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="KhuVuc" class="form-label fw-bold"><i class="fas fa-layer-group me-1 text-warning"></i>Khu Vực</label>
                                <select asp-for="KhuVuc" class="form-select border-2 shadow-none">
                                    <option value="Phim Đang Chiếu">Phim Đang Chiếu</option>
                                    <option value="Phim Sắp Chiếu">Phim Sắp Chiếu</option>
                                    <option value="Phim Hot">Phim Hot Trending</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FileAnh" class="form-label fw-bold"><i class="fas fa-image me-1 text-warning"></i>Thay Đổi Poster</label>
                            <input asp-for="FileAnh" type="file" class="form-control border-2" id="imgInput" accept="image/*" />
                            <div class="form-text mt-1 text-muted">Để trống nếu Hiếu muốn giữ nguyên ảnh hiện tại.</div>
                        </div>
                    </div>

                    @* --- CỘT PHẢI: PREVIEW --- *@
                    <div class="col-lg-4 text-center border-start">
                        <div class="sticky-top" style="top: 20px;">
                            <label class="fw-bold d-block mb-3 text-muted">POSTER HIỆN TẠI / MỚI</label>

                            @* Dùng lại class preview-box để đồng bộ tỉ lệ 2:3 *@
                            <div class="preview-box shadow-sm mx-auto" style="max-width: 280px;">
                                <img id="imgPreview"
                                     src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "https://placehold.co/400x600?text=No+Poster" : Model.HinhAnh)"
                                     alt="Preview" />
                            </div>
                            <p class="small text-muted mt-2 italic">Tỉ lệ chuẩn 2:3</p>
                        </div>
                    </div>
                </div>

                @* Khối nút bấm cuối trang *@
                <div class="form-section-divider text-center text-lg-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill me-2">
                        <i class="fas fa-undo me-2"></i>Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning px-5 py-2 rounded-pill fw-bold shadow text-dark">
                        <i class="fas fa-save me-2"></i>CẬP NHẬT NGAY
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xử lý thay đổi ảnh Preview khi Hiếu chọn file mới
        document.getElementById('imgInput').onchange = function (evt) {
            const [file] = this.files;
            if (file) {
                const preview = document.getElementById('imgPreview');
                preview.src = URL.createObjectURL(file);
                preview.onload = () => URL.revokeObjectURL(preview.src);
            }
        };
    </script>
}