@model WebPhim.Models.Phim

<div class="container py-4 admin-card-container">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i>XÁC NHẬN XÓA PHIM</h5>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-light border-start border-danger border-4 shadow-sm mb-4">
                <h4 class="text-danger fw-bold">Cảnh báo!</h4>
                <p class="mb-0 text-muted">Hiếu có chắc chắn muốn xóa bộ phim <strong>@Model.TenPhim</strong> không? Hành động này sẽ xóa vĩnh viễn dữ liệu và tập tin hình ảnh.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-3">
                    <div class="preview-box shadow rounded overflow-hidden" style="aspect-ratio: 2/3;">
                        <img src="@Model.HinhAnh" class="w-100 h-100" style="object-fit: cover;" alt="Poster" />
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="bg-light p-4 rounded-3 h-100 d-flex flex-column">
                        <h3 class="fw-bold text-dark mb-3">@Model.TenPhim</h3>
                        <dl class="row mb-4 flex-grow-1">
                            <dt class="col-sm-3 text-muted">Đạo diễn:</dt>
                            <dd class="col-sm-9 fw-bold">@Model.DaoDien</dd>

                            <dt class="col-sm-3 text-muted">Thể loại:</dt>
                            <dd class="col-sm-9">
                                <span class="badge bg-info text-dark">@Model.LoaiPhim</span>
                            </dd>

                            <dt class="col-sm-3 text-muted">Thời lượng:</dt>
                            <dd class="col-sm-9">@Model.ThoiLuong phút</dd>

                            <dt class="col-sm-3 text-muted">Khu vực:</dt>
                            <dd class="col-sm-9">@Model.KhuVuc</dd>
                        </dl>

                        <div class="pt-3 border-top">
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="Id" />

                                <button type="submit" class="btn btn-danger btn-lg px-5 rounded-pill shadow fw-bold">
                                    <i class="fas fa-check me-2"></i>Xóa Vĩnh Viễn
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill ms-2">
                                    <i class="fas fa-times me-2"></i>Quay lại
                                </a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>