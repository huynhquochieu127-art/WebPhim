@model IEnumerable<WebPhim.Models.Phong>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase fw-bold text-success">Quản Lý Phòng Chiếu</h2>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Thêm Phòng Mới
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Tên Phòng</th>
                        <th>Thuộc Rạp</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.TenPhong</td>
                            <td><span class="badge bg-info text-dark">@item.Rap?.TenRap</span></td>
                            <td class="text-center">
                                <a asp-controller="Ghe" asp-action="Index" asp-route-phongId="@item.Id"
                                   class="btn btn-sm btn-outline-primary px-3 me-2">
                                    <i class="fas fa-chair me-1"></i> Ghế
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   onclick="return confirm('Xóa phòng sẽ mất dữ liệu ghế, Hiếu chắc chứ?')"
                                   class="btn btn-sm btn-outline-danger px-3">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>