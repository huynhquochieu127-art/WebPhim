@model IEnumerable<WebPhim.Models.Ghe>

@section Styles {
    @* Kết nối đúng với file CSS chọn ghế ông đã gửi *@
    <link rel="stylesheet" href="~/css/Ghe.css" asp-append-version="true" />
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Phong" asp-action="Index">Quản lý Phòng</a></li>
            <li class="breadcrumb-item active">Sơ đồ ghế</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-uppercase">Thiết lập sơ đồ ghế</h2>
            <p class="text-muted">Phòng: <span class="text-danger fw-bold">@ViewBag.TenPhong</span></p>
        </div>

        @if (!Model.Any())
        {
            <form asp-action="AutoGenerateSeats" method="post">
                <input type="hidden" name="phongId" value="@ViewBag.PhongId" />
                <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold">
                    <i class="fas fa-magic me-2"></i>Tự động tạo 50 ghế
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
        @* 1. Màn hình rạp phim *@
        <div class="cinema-screen">MÀN HÌNH</div>

        <div class="card-body p-5">
            @if (Model.Any())
            {
                @* 2. Container bọc các hàng ghế - Sử dụng đúng class trong Ghe.css *@
                <div class="seat-container">
                    @{
                        // Nhóm ghế theo ký tự đầu (A, B, C...) để tạo hàng
                        var groups = Model.OrderBy(g => g.SoGhe)
                        .GroupBy(g => g.SoGhe.Substring(0, 1));
                    }

                    @foreach (var row in groups)
                    {
                        <div class="seat-row">
                            @* Nhãn hàng bên trái *@
                            <div class="row-label">@row.Key</div>

                            @foreach (var item in row)
                            {
                                @* Kiểm tra Logic VIP: hàng E hoặc LoaiGhe == "VIP" *@
                                var isVipClass = (item.LoaiGhe == "VIP" || item.SoGhe.StartsWith("E")) ? "seat-vip" : "";

                                <div class="seat-item @isVipClass" title="Loại ghế: @item.LoaiGhe">
                                    @item.SoGhe
                                </div>
                            }

                            @* Nhãn hàng bên phải cho cân đối *@
                            <div class="row-label">@row.Key</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="alert alert-info d-inline-block px-5 border-0 shadow-sm">
                        <i class="fas fa-info-circle me-2"></i>Chưa có dữ liệu ghế cho phòng này.
                    </div>
                </div>
            }
        </div>

        @* 3. Chú thích các loại ghế *@
        <div class="card-footer bg-light border-0 py-4 text-center">
            <div class="d-flex justify-content-center gap-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="seat-item" style="width: 25px; height: 25px; cursor: default;"></div>
                    <small class="fw-bold text-muted">Ghế thường</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="seat-item seat-vip" style="width: 25px; height: 25px; cursor: default;"></div>
                    <small class="fw-bold text-muted">Ghế VIP (Hàng E)</small>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-area="Admin" asp-controller="Phong" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách phòng
        </a>
    </div>
</div>