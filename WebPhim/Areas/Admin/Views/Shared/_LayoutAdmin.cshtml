<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin CinemaVP</title>

    @* CSS chuẩn: Bootstrap và FontAwesome *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-admin {
            background-color: #1a1a1a;
            padding: 0.8rem 0;
        }

        .nav-link {
            font-weight: 500;
            transition: all 0.2s;
        }

            .nav-link:hover {
                color: #ffc107 !important; /* Màu vàng đặc trưng của Admin */
            }

        .active-admin {
            color: #ffc107 !important;
            border-bottom: 2px solid #ffc107;
        }

        .admin-search-input {
            background-color: #2b2b2b !important;
            border: none !important;
            color: white !important;
        }

            .admin-search-input::placeholder {
                color: #888;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* THANH QUẢN TRỊ NÂNG CẤP *@
    <nav class="navbar navbar-expand-lg navbar-dark navbar-admin shadow-sm mb-4 sticky-top">
        <div class="container">
            @* Logo dẫn về danh sách phim của Admin *@
            <a class="navbar-brand fw-bold" asp-area="Admin" asp-controller="Phim" asp-action="Index">
                <i class="fas fa-user-shield me-2 text-warning"></i>HỆ THỐNG QUẢN TRỊ
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Phim" asp-action="Index">Phim</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Rap" asp-action="Index">Rạp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Phong" asp-action="Index">Phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="LichChieu" asp-action="Index">Lịch chiếu</a>
                    </li>
                    <li class="nav-item ms-lg-3">
                        @* Nút quay lại trang chủ người dùng *@
                        <a class="nav-link text-info" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-external-link-alt me-1"></i>Xem trang chủ
                        </a>
                    </li>
                </ul>

                @* Thanh tìm kiếm nội bộ cho Admin *@
                <form class="d-flex mx-lg-4 my-2 my-lg-0" asp-area="Admin" asp-controller="Phim" asp-action="Index" method="get">
                    <div class="input-group">
                        <input class="form-control admin-search-input rounded-start-pill ps-3 shadow-none"
                               name="searchTerm" placeholder="Tìm phim nhanh...">
                        <button class="btn btn-warning rounded-end-pill px-3 shadow-none" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                @* Thông tin tài khoản *@
                <div class="navbar-nav ms-auto align-items-center">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white small" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-circle text-success me-1" style="font-size: 10px;"></i>
                            @(User.Identity?.Name ?? "Quản trị viên")
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Hồ sơ cá nhân</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    @* NỘI DUNG CHÍNH *@
    <main role="main" class="pb-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    @* Footer tối giản cho Admin *@
    <footer class="py-4 bg-white border-top mt-auto">
        <div class="container text-center text-muted small">
            &copy; 2026 - Bảng điều khiển quản trị CinemaVP
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>