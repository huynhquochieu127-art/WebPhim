<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị CinemaVP</title>

    @* Bootstrap & Fonts *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/LayoutAdmin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-2">
            <div class="container">
                @* Logo thương hiệu *@
                <a class="navbar-brand fw-bold text-danger fs-3 me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-film me-2"></i>CinemaVP
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    @* DANH SÁCH NÚT QUẢN LÝ DÀN HÀNG NGANG *@
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link px-3 text-dark fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        @* Vạch ngăn cách nhẹ *@
                        <li class="nav-item d-none d-lg-block mx-1" style="border-left: 1px solid #eee; height: 20px;"></li>

                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Phim" ? "active text-danger fw-bold" : "text-dark")"
                               asp-area="Admin" asp-controller="Phim" asp-action="Index">Phim</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Rap" ? "active text-danger fw-bold" : "text-dark")"
                               asp-area="Admin" asp-controller="Rap" asp-action="Index">Rạp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Phong" ? "active text-danger fw-bold" : "text-dark")"
                               asp-area="Admin" asp-controller="Phong" asp-action="Index">Phòng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "LichChieu" ? "active text-danger fw-bold" : "text-dark")"
                               asp-area="Admin" asp-controller="LichChieu" asp-action="Index">Lịch chiếu</a>
                        </li>
                    </ul>

                    @* ĐẨY PHẦN LOGIN SÁT VỀ BÊN PHẢI (BỎ THANH TÌM KIẾM TẠI ĐÂY) *@
                    <div class="ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0 my-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-4 bg-white border-top">
        <div class="container text-center">
            <span class="text-muted small">&copy; 2026 - <span class="fw-bold text-danger">CinemaVP Admin Panel</span></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>