@model WebPhim.Models.Phim
@{
    ViewData["Title"] = Model.TenPhim + " - Chi tiết phim";
    var culture = new System.Globalization.CultureInfo("vi-VN");

    // Lấy suất chiếu từ thời điểm hiện tại và nhóm theo ngày
    var bayGio = DateTime.Now;
    var lichTheoNgay = Model.LichChieus?
        .Where(l => l.ThoiGianChieu >= bayGio)
        .GroupBy(l => l.ThoiGianChieu.Date)
        .OrderBy(g => g.Key)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/MovieDetail_User.css" asp-append-version="true" />
}

<div id="user-detail-wrapper" class="container py-5 movie-details-wrapper">
   
    <div class="d-flex align-items-center mb-4">
        <<a href="javascript:void(0);" onclick="history.back();" class="btn btn-outline-secondary btn-sm rounded-pill me-3">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        <h2 class="h3 mb-0 fw-bold text-dark">Chi tiết phim hệ thống</h2>
    </div>

    <div class="row g-5">
        @* --- CỘT TRÁI: POSTER & NÚT ĐẶT VÉ --- *@
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 20px; z-index: 10;">
                <div class="poster-container">
                    <div class="poster-card shadow-lg border-0">
                        @if (!string.IsNullOrEmpty(Model.HinhAnh))
                        {
                            <img src="@Model.HinhAnh" alt="@Model.TenPhim" class="img-fluid w-100">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light" style="height: 450px;">
                                <i class="fas fa-image fa-4x text-muted"></i>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4" style="max-width: 320px; margin-left: auto; margin-right: auto;">
                    <a href="#suat-chieu-section" class="btn btn-danger shadow py-3 rounded-pill fw-bold">
                        <i class="fas fa-ticket-alt me-2"></i>ĐẶT VÉ NGAY
                    </a>
                </div>
            </div>
        </div>

        @* --- CỘT PHẢI: THÔNG TIN --- *@
        <div class="col-lg-8">
            <div class="movie-header mb-4">
                <h1 class="display-5 fw-bold text-dark movie-title">@Model.TenPhim</h1>
                <div class="d-flex flex-wrap gap-3 mt-3 align-items-center">
                    <span class="badge bg-danger rounded-pill px-3 py-2 shadow-sm">@Model.LoaiPhim</span>
                    <span class="text-muted"><i class="far fa-clock me-1 text-danger"></i> @Model.ThoiLuong phút</span>
                    <span class="text-muted"><i class="fas fa-user-tie me-1 text-danger"></i> @Model.DaoDien</span>
                </div>
            </div>

            <div class="content-section mb-5 p-4 bg-white rounded-4 shadow-sm border">
                <h6 class="fw-bold text-uppercase small text-muted mb-3">Nội dung phim</h6>
                <p class="movie-description text-secondary mb-0">@Model.MoTa</p>
            </div>

            <hr class="my-5 opacity-25" id="suat-chieu-section">

            @* --- LỊCH CHIẾU --- *@
            <div class="booking-section">
                <h4 class="fw-bold mb-4 text-dark text-uppercase">Lịch chiếu tại rạp</h4>

                @if (lichTheoNgay != null && lichTheoNgay.Any())
                {
                    <ul class="nav nav-pills nav-date-pills mb-4 d-flex flex-nowrap overflow-auto pb-2" id="pills-tab" role="tablist">
                        @for (int i = 0; i < lichTheoNgay.Count; i++)
                        {
                            var ngay = lichTheoNgay[i].Key;
                            <li class="nav-item" role="presentation">
                                <button class="nav-link @(i == 0 ? "active" : "")"
                                        id="day-tab-@i"
                                        data-bs-toggle="pill"
                                        data-bs-target="#day-content-@i"
                                        type="button" role="tab">
                                    <small class="d-block opacity-75">@ngay.ToString("MM/yyyy")</small>
                                    <strong class="fs-5 d-block">@ngay.ToString("dd")</strong>
                                    <small class="fw-bold text-uppercase">@ngay.ToString("ddd", culture)</small>
                                </button>
                            </li>
                        }
                    </ul>

                    <div class="tab-content" id="pills-tabContent">
                        @for (int i = 0; i < lichTheoNgay.Count; i++)
                        {
                            <div class="tab-pane fade @(i == 0 ? "show active" : "")"
                                 id="day-content-@i" role="tabpanel">
                                <div class="row g-3">
                                    @foreach (var lc in lichTheoNgay[i].OrderBy(x => x.ThoiGianChieu))
                                    {
                                        <div class="col-md-4 col-lg-3 col-6">
                                            <a asp-controller="DatVe" asp-action="ChonGhe" asp-route-id="@lc.Id" class="text-decoration-none">
                                                <div class="time-slot shadow-sm border rounded-4 p-3 text-center bg-white h-100">
                                                    <div class="theater-name small fw-bold mb-1 text-muted text-truncate">
                                                        @lc.Phong?.Rap?.TenRap
                                                    </div>
                                                    <div class="fw-bold fs-4 text-dark">@lc.ThoiGianChieu.ToString("HH:mm")</div>
                                                    <div class="small text-secondary mt-1">@lc.Phong?.TenPhong</div>
                                                </div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border rounded-4 p-5 text-center shadow-sm">
                        <i class="fas fa-calendar-times fa-3x text-muted mb-3 d-block"></i>
                        <h6 class="fw-bold">Chưa có suất chiếu hiện dụng</h6>
                        <p class="text-secondary small">Vui lòng quay lại sau hoặc chọn phim khác nhé!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Smooth scroll nâng cao
        document.querySelector('a[href^="#"]').addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if(target) {
                window.scrollTo({
                    top: target.offsetTop - 20, // Trừ hao khoảng cách để không bị dính sát mép
                    behavior: 'smooth'
                });
            }
        });
    </script>
}