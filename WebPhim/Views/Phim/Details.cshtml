@model WebPhim.Models.Phim
@{
    ViewData["Title"] = Model.TenPhim + " - Chi tiết";
}

@section Styles {
    <link rel="stylesheet" href="~/css/MovieDetail.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
    </div>

    <div class="row g-5">
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 20px;">
                <img src="@Model.HinhAnh" class="img-fluid rounded-4 shadow-lg w-100" alt="@Model.TenPhim">
                <div class="d-grid gap-2 mt-4">
                    <a href="#suat-chieu" class="btn btn-danger btn-lg rounded-pill fw-bold">ĐẶT VÉ NGAY</a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <h1 class="display-5 fw-bold">@Model.TenPhim</h1>
            <p class="text-muted">@Model.LoaiPhim | @Model.ThoiLuong phút | @Model.DaoDien</p>

            <h5 class="fw-bold mt-4">NỘI DUNG</h5>
            <p class="text-secondary" style="text-align: justify; line-height: 1.7;">@Model.MoTa</p>

            <hr class="my-5" id="suat-chieu">

            <h4 class="fw-bold mb-4 text-primary">SUẤT CHIẾU TẠI RẠP</h4>
            @if (Model.LichChieus != null && Model.LichChieus.Any())
            {
                <div class="row g-3">
                    @foreach (var lc in Model.LichChieus.OrderBy(x => x.ThoiGianChieu))
                    {
                        <div class="col-md-4">
                            <a asp-controller="DatVe" asp-action="ChonGhe" asp-route-id="@lc.Id" class="btn btn-outline-primary w-100 py-3 rounded-3 shadow-sm">
                                <div class="fw-bold fs-5">@lc.ThoiGianChieu.ToString("HH:mm")</div>
                                <small class="d-block text-dark">@lc.Phong?.Rap?.TenRap - @lc.Phong?.TenPhong</small>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border">Chưa có lịch chiếu cho phim này.</div>
            }
        </div>
    </div>
</div>