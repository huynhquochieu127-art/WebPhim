@model WebPhim.Models.LichChieu
@{
    ViewData["Title"] = "Chọn ghế - " + Model.Phim?.TenPhim;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Ghe.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="cinema-screen shadow-sm">MÀN HÌNH</div>

            <div class="seat-container mb-5">
                @if (Model.Phong?.Ghes != null && Model.Phong.Ghes.Any())
                {
                    @* Nhóm ghế theo ký tự đầu (A, B, C...) *@
                    var rows = Model.Phong.Ghes
                    .GroupBy(g => g.SoGhe.Substring(0, 1))
                    .OrderBy(group => group.Key);

                    foreach (var row in rows)
                    {
                        <div class="seat-row mb-3">
                            @* Nhãn hàng ghế bên trái *@
                            <div class="row-label">@row.Key</div>

                            @foreach (var ghe in row.OrderBy(g => g.SoGhe.Length).ThenBy(g => g.SoGhe))
                            {
                                @* Logic nhận diện ghế VIP hoặc hàng E *@
                                var isVip = (ghe.LoaiGhe == "VIP" || row.Key == "E") ? "seat-vip" : "";
                                var isOccupied = ""; // Tạm thời để trống để test

                                <div class="seat-item @isVip @isOccupied"
                                     data-id="@ghe.Id"
                                     data-name="@ghe.SoGhe"
                                     data-price="@(isVip != "" ? 120000 : 80000)"
                                     title="Ghế @ghe.SoGhe">
                                    @ghe.SoGhe
                                </div>
                            }

                            @* Nhãn hàng ghế bên phải *@
                            <div class="row-label">@row.Key</div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning text-center">Chưa có sơ đồ ghế cho phòng này.</div>
                }
            </div>

            @* Chú thích màu sắc *@
            <div class="d-flex justify-content-center gap-4 mt-5 border-top pt-4">
                <div class="seat-legend-item"><div class="seat-item" style="width:25px;height:25px"></div> <span>Trống</span></div>
                <div class="seat-legend-item"><div class="seat-item seat-vip" style="width:25px;height:25px"></div> <span>Ghế VIP</span></div>
                <div class="seat-legend-item"><div class="seat-item selected" style="width:25px;height:25px"></div> <span>Đang chọn</span></div>
                <div class="seat-legend-item"><div class="seat-item occupied" style="width:25px;height:25px"></div> <span>Đã bán</span></div>
            </div>
        </div>

        @* Cột thông tin vé *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg p-4 rounded-4 bg-white sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-4 text-primary border-bottom pb-2">VÉ CỦA BẠN</h4>
                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-bold">Phim</label>
                    <div class="fw-bold fs-5 text-dark">@Model.Phim?.TenPhim</div>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Rạp</label>
                        <div class="fw-bold text-dark">@Model.Phong?.Rap?.TenRap</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Phòng</label>
                        <div class="fw-bold text-dark">@Model.Phong?.TenPhong</div>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="text-muted small text-uppercase fw-bold">Suất chiếu</label>
                    <div class="fw-bold text-dark">@Model.ThoiGianChieu.ToString("HH:mm | dd/MM/yyyy")</div>
                </div>

                <hr class="border-secondary opacity-25">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted">Ghế đã chọn:</span>
                    <span id="display-seats" class="badge bg-primary fs-6 shadow-sm">Chưa chọn</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted">Tổng tiền:</span>
                    <h3 id="total-price" class="fw-bold text-danger mb-0">0đ</h3>
                </div>

                <button id="btn-confirm" class="btn btn-danger w-100 btn-lg rounded-pill fw-bold py-3 shadow-sm mt-2">
                    XÁC NHẬN ĐẶT VÉ
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            let selectedSeats = [];
            let totalPrice = 0;

            $('.seat-item').click(function () {
                // Không cho chọn ghế đã bán
                if ($(this).hasClass('occupied')) return;

                const seatId = $(this).data('id');
                const seatName = $(this).data('name');
                const seatPrice = parseInt($(this).data('price'));

                if ($(this).hasClass('selected')) {
                    // Bỏ chọn
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== seatId);
                    totalPrice -= seatPrice;
                } else {
                    // Chọn mới
                    $(this).addClass('selected');
                    selectedSeats.push({ id: seatId, name: seatName });
                    totalPrice += seatPrice;
                }

                // Cập nhật giao diện bên phải
                if (selectedSeats.length > 0) {
                    $('#display-seats').text(selectedSeats.map(s => s.name).join(', '));
                } else {
                    $('#display-seats').text('Chưa chọn');
                }

                // Định dạng tiền Việt Nam (VNĐ)
                $('#total-price').text(totalPrice.toLocaleString('vi-VN') + 'đ');
            });
        });
    </script>
}