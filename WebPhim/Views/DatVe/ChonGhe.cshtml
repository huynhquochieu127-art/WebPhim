@model WebPhim.Models.LichChieu
@{
    ViewData["Title"] = "Chọn ghế - " + Model.Phim?.TenPhim;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Ghe.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row g-5">
        @* Cột trái: Sơ đồ ghế *@
        <div class="col-lg-8">
            <div class="cinema-screen shadow-sm mb-5">MÀN HÌNH</div>

            <div class="seat-container mb-5">
                @if (Model.Phong?.Ghes != null && Model.Phong.Ghes.Any())
                {
                    // Sắp xếp các hàng theo đúng thứ tự A-E
                    var rows = Model.Phong.Ghes
                    .GroupBy(g => g.SoGhe.Substring(0, 1))
                    .OrderBy(group => group.Key);

                    @foreach (var row in rows)
                    {
                        <div class="seat-row mb-3">
                            <div class="row-label">@row.Key</div>

                            @foreach (var ghe in row.OrderBy(g => g.SoGhe.Length).ThenBy(g => g.SoGhe))
                            {
                                var giaGoc = Model.GiaVe;
                                var price = giaGoc;
                                var seatClass = "";

                                // LOGIC PHÂN LOẠI GIÁ VÀ CLASS THEO HÀNG
                                if (row.Key == "D" || row.Key == "E" || ghe.LoaiGhe == "VIP")
                                {
                                    // HÀNG ĐẸP (VIP): Tăng 20k
                                    seatClass = "seat-vip";
                                    price = giaGoc + 20000;
                                }
                                else if (row.Key == "A")
                                {
                                    // TIẾT KIỆM: Giảm 10k
                                    seatClass = "seat-cheap";
                                    price = giaGoc - 10000;
                                }
                                else
                                {
                                    // TIÊU CHUẨN (Hàng B, C): Giữ nguyên giá gốc
                                    seatClass = ""; // Không thêm class đặc biệt, sẽ hiện màu trắng tiêu chuẩn
                                    price = giaGoc;
                                }

                                <div class="seat-item @seatClass"
                                     data-id="@ghe.Id"
                                     data-name="@ghe.SoGhe"
                                     data-price="@price"
                                     title="Ghế @ghe.SoGhe - @price.ToString("N0")đ">
                                    @ghe.SoGhe
                                </div>
                            }

                            <div class="row-label">@row.Key</div>
                        </div>
                    }
                }
            </div>

            @* Chú thích màu sắc - Đã fix giống Admin *@
            <div class="d-flex justify-content-center gap-4 mt-5 border-top pt-4">
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item seat-cheap" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted text-uppercase">Tiết kiệm </span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted text-uppercase">Tiêu chuẩn</span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item seat-vip" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted text-uppercase">Hàng đẹp </span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item selected" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted text-uppercase">Đang chọn</span>
                </div>
            </div>
        </div>

        @* Cột phải: Thông tin vé (Giữ nguyên logic của Hiếu vì đã ổn) *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg p-4 rounded-4 bg-white sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-4 text-primary border-bottom pb-2">VÉ CỦA BẠN</h4>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-bold">Phim</label>
                    <div class="fw-bold fs-5 text-dark">@Model.Phim?.TenPhim</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Phòng</label>
                        <div class="fw-bold text-dark">@Model.Phong?.TenPhong</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Suất</label>
                        <div class="fw-bold text-dark">@Model.ThoiGianChieu.ToString("HH:mm")</div>
                    </div>
                </div>

                <hr class="border-secondary opacity-25">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Ghế đã chọn:</span>
                    <span id="display-seats" class="badge bg-primary fs-6 shadow-sm">Chưa chọn</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted">Tổng tiền:</span>
                    <h3 id="total-price" class="fw-bold text-danger mb-0">0đ</h3>
                </div>

                <form asp-action="XacNhanDatVe" method="post">
                    <input type="hidden" name="LichChieuId" value="@Model.Id" />
                    <input type="hidden" id="selected-seats-input" name="SelectedSeats" />
                    <button type="submit" id="btn-confirm" class="btn btn-danger w-100 btn-lg rounded-pill fw-bold py-3 shadow-sm" disabled>
                        XÁC NHẬN ĐẶT VÉ
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            let selectedSeats = [];
            let totalPrice = 0;

            $('.seat-item').click(function () {
                // Chặn click nếu ghế đã được đặt (occupied)
                if ($(this).hasClass('occupied')) return;

                const seatId = $(this).data('id');
                const seatName = $(this).data('name');
                const seatPrice = parseInt($(this).data('price'));

                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== seatId);
                    totalPrice -= seatPrice;
                } else {
                    $(this).addClass('selected');
                    selectedSeats.push({ id: seatId, name: seatName });
                    totalPrice += seatPrice;
                }

                // Cập nhật giao diện
                $('#display-seats').text(selectedSeats.length > 0 ? selectedSeats.map(s => s.name).join(', ') : 'Chưa chọn');
                $('#total-price').text(totalPrice.toLocaleString('vi-VN') + 'đ');

                // Lưu ID vào input hidden để submit form
                $('#selected-seats-input').val(selectedSeats.map(s => s.id).join(','));
                $('#btn-confirm').prop('disabled', selectedSeats.length === 0);
            });
        });
    </script>
}