@model WebPhim.Models.LichChieu
@{
    ViewData["Title"] = "Chọn ghế - " + Model.Phim?.TenPhim;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Ghe.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row g-5">
        @* Cột trái: Sơ đồ ghế *@
        <div class="col-lg-8">
            <div class="cinema-screen shadow-sm mb-5 text-center py-2 bg-dark text-white rounded-pill opacity-75">MÀN HÌNH</div>

            <div class="seat-container mb-5">
                @if (Model.Phong?.Ghes != null && Model.Phong.Ghes.Any())
                {
                    // Nhóm ghế theo hàng (A, B, C...)
                    var rows = Model.Phong.Ghes
                        .GroupBy(g => g.SoGhe.Substring(0, 1))
                        .OrderBy(group => group.Key);

                    @foreach (var row in rows)
                    {
                        <div class="seat-row mb-3 d-flex align-items-center justify-content-center">
                            <div class="row-label me-3 fw-bold text-muted" style="width: 20px;">@row.Key</div>

                            @foreach (var ghe in row.OrderBy(g => int.Parse(g.SoGhe.Substring(1))))
                            {
                                var giaGoc = Model.GiaVe;
                                var price = giaGoc;
                                var seatClass = "";

                                // Tính toán giá và loại ghế dựa trên hàng (Khớp với Controller)
                                if (row.Key == "D" || row.Key == "E" || ghe.LoaiGhe == "VIP")
                                {
                                    seatClass = "seat-vip";
                                    price = giaGoc + 20000;
                                }
                                else if (row.Key == "A")
                                {
                                    seatClass = "seat-cheap";
                                    price = giaGoc - 10000;
                                }

                                // Kiểm tra ghế đã bán dựa trên quan hệ navigation Ves trong model LichChieu
                                bool isBooked = Model.Ves?.Any(v => v.GheId == ghe.Id) ?? false;

                                <div class="seat-item @seatClass @(isBooked ? "occupied" : "")"
                                     data-id="@ghe.Id"
                                     data-name="@ghe.SoGhe"
                                     data-price="@(isBooked ? 0 : price)"
                                     title="@(isBooked ? "Ghế đã có người đặt" : $"Ghế {ghe.SoGhe} - {price.ToString("N0")}đ")">
                                    @ghe.SoGhe
                                </div>
                            }

                            <div class="row-label ms-3 fw-bold text-muted" style="width: 20px;">@row.Key</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center text-muted italic">Chưa có dữ liệu ghế cho phòng này.</p>
                }
            </div>

            @* Chú thích *@
            <div class="d-flex justify-content-center flex-wrap gap-4 mt-5 border-top pt-4">
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item seat-cheap" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted">TIẾT KIỆM</span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted">TIÊU CHUẨN</span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item seat-vip" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted">VIP</span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item selected" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted">ĐANG CHỌN</span>
                </div>
                <div class="seat-legend-item d-flex align-items-center gap-2">
                    <div class="seat-item occupied" style="cursor: default;"></div>
                    <span class="small fw-bold text-muted">ĐÃ BÁN</span>
                </div>
            </div>
        </div>

        @* Cột phải: Thông tin đặt vé *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg p-4 rounded-4 bg-white sticky-top" style="top: 20px;">
                <h4 class="fw-bold mb-4 text-danger border-bottom pb-2 text-uppercase">Hóa đơn của bạn</h4>

                <div class="mb-3">
                    <label class="text-muted small text-uppercase fw-bold">Phim</label>
                    <div class="fw-bold fs-5 text-dark">@Model.Phim?.TenPhim</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Phòng</label>
                        <div class="fw-bold text-dark">@Model.Phong?.TenPhong</div>
                    </div>
                    <div class="col-6">
                        <label class="text-muted small text-uppercase fw-bold">Giờ chiếu</label>
                        <div class="fw-bold text-dark">@Model.ThoiGianChieu.ToString("HH:mm")</div>
                    </div>
                </div>

                <hr class="border-secondary opacity-25">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Ghế:</span>
                    <span id="display-seats" class="badge bg-danger fs-6 shadow-sm">Chưa chọn</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="text-muted">Tổng cộng:</span>
                    <h3 id="total-price" class="fw-bold text-danger mb-0">0đ</h3>
                </div>

                @* FIX QUAN TRỌNG: Thêm asp-controller="DatVe" để tránh lỗi 404 *@
                <form asp-controller="DatVe" asp-action="XacNhanDatVe" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="LichChieuId" value="@Model.Id" />
                    <input type="hidden" id="selected-seats-input" name="SelectedSeats" />
                    
                    <button type="submit" id="btn-confirm" class="btn btn-danger w-100 btn-lg rounded-pill fw-bold py-3 shadow-sm" disabled>
                        XÁC NHẬN ĐẶT VÉ
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            let selectedSeats = [];
            let totalPrice = 0;

            $('.seat-item').click(function () {
                if ($(this).hasClass('occupied')) return;

                const seatId = $(this).data('id');
                const seatName = $(this).data('name');
                const seatPrice = parseInt($(this).data('price'));

                if ($(this).hasClass('selected')) {
                    $(this).removeClass('selected');
                    selectedSeats = selectedSeats.filter(s => s.id !== seatId);
                    totalPrice -= seatPrice;
                } else {
                    $(this).addClass('selected');
                    selectedSeats.push({ id: seatId, name: seatName });
                    totalPrice += seatPrice;
                }

                // Cập nhật UI
                $('#display-seats').text(selectedSeats.length > 0 ? selectedSeats.map(s => s.name).join(', ') : 'Chưa chọn');
                $('#total-price').text(totalPrice.toLocaleString('vi-VN') + 'đ');

                // Đồng bộ với input hidden để submit form
                $('#selected-seats-input').val(selectedSeats.map(s => s.id).join(','));
                
                // Toggle nút xác nhận
                $('#btn-confirm').prop('disabled', selectedSeats.length === 0);
            });
        });
    </script>
}