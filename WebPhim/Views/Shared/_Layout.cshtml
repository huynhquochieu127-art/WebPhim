<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaVP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Layout.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #fcfcfc;
        }

        .navbar {
            transition: all 0.3s;
        }

        .nav-link {
            font-weight: 600;
            transition: color 0.2s;
        }

            .nav-link:hover {
                color: #dc3545 !important;
            }

        .footer {
            border-top: 1px solid #eee;
            background: #fff;
        }

        /* Đảm bảo menu không bị mũi tên */
        .no-caret::after {
            display: none !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-danger fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-film me-2"></i>CinemaVP
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                @* FIX: Đã chuyển từ Dropdown thành 1 Link bấm duy nhất *@
                                <a class="nav-link text-primary fw-bold" asp-area="Admin" asp-controller="Phim" asp-action="Index">
                                    <i class="fas fa-user-shield me-1"></i>Quản Trị
                                </a>
                            </li>
                        }
                    </ul>

                    <form asp-controller="Home" asp-action="Index" method="get" class="d-flex flex-grow-1 mx-lg-4" style="max-width: 450px;">
                        <div class="input-group">
                            <input type="text"
                                   name="searchString"
                                   value="@ViewData["CurrentFilter"]"
                                   class="form-control border border-end-0 rounded-start-pill bg-light ps-4"
                                   placeholder="Tìm phim, thể loại..."
                                   style="height: 45px; font-size: 0.95rem;" />
                            <button type="submit" class="btn btn-light border border-start-0 rounded-end-pill text-muted px-3" style="height: 45px;">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <div class="ms-lg-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-5">
        <div class="container text-center">
            <div class="mb-3">
                <a class="text-decoration-none text-danger fw-bold fs-4" href="#">CinemaVP</a>
            </div>
            <div class="social-links mb-4">
                <a href="#" class="text-muted mx-3 fs-5"><i class="fab fa-facebook"></i></a>
                <a href="#" class="text-muted mx-3 fs-5"><i class="fab fa-instagram"></i></a>
                <a href="#" class="text-muted mx-3 fs-5"><i class="fab fa-youtube"></i></a>
            </div>
            <p class="text-muted small mb-0">&copy; 2026 - <span class="fw-bold">CinemaVP Entertainment</span>. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>