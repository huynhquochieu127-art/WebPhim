@using Microsoft.AspNetCore.Identity
@using WebPhim.Models
@inject SignInManager<NguoiDung> SignInManager
@inject UserManager<NguoiDung> UserManager

<ul class="navbar-nav ms-auto align-items-center auth-nav-group">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayAlias = user?.HoTen ?? UserManager.GetUserName(User);

        <li class="nav-item">
            <a class="nav-link user-profile-link px-3" asp-area="Identity" asp-page="/Account/Manage/Index">
                <i class="fas fa-user-circle me-2 text-danger"></i>
                <span class="d-none d-sm-inline fw-600">Chào, @displayAlias!</span>
            </a>
        </li>
        <li class="nav-item">
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn-logout-nav ms-2">
                    <i class="fas fa-power-off me-1"></i>Thoát
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            @* QUAN TRỌNG: Chỉ giữ lại đúng class btn-login-nav để CSS can thiệp *@
            <a class="btn-login-nav" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
        <li class="nav-item ms-lg-2">
            <a class="btn-register-nav" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        </li>
    }
</ul>